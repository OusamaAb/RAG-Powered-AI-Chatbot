# Required server-side secrets
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# Optional chat API security controls
# Comma-separated origins allowed to call /api/chat in production.
# Example: https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=

# Comma-separated exact IPs allowed to call /api/chat.
# Leave blank for a public portfolio chatbot. Only set this if requests are routed
# through a trusted backend/proxy IP, otherwise normal visitors will be blocked.
TRUSTED_API_IPS=

# Require Origin/Referer checks. Defaults to true in production and false locally.
CHAT_API_REQUIRE_ORIGIN=

# Per-client rate limit, keyed by IP plus browser session id.
# Use "supabase" on Render after running the chat_rate_limits migration.
# Locally, "memory" avoids requiring the migration before quick testing.
CHAT_RATE_LIMIT_BACKEND=supabase
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=8
CHAT_RATE_LIMIT_BLOCK_MS=120000

# Keep false in production. If true, raw retrieved chunks are returned for debugging.
CHAT_API_DEBUG_RESPONSE=false
